---
const { name, title, dates, brand, logo, background, text, bullets, link, featured } = Astro.props;
---

<article class:list={['tile reveal overflow-hidden flex flex-col', { 'lg:col-span-2 lg:flex-row': featured }]} style={`--brand:${brand}`}>
	<div class:list={['relative flex justify-center items-center h-56 shrink-0 bg-white', { 'lg:w-2/5 lg:h-auto': featured }]}>
		<img src={background} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
		<img src={logo} alt="" class="relative h-44 w-full object-contain p-3" loading="lazy" decoding="async" />
	</div>
	<div class="flex flex-col grow p-5 gap-2">
		<h3 class="text-2xl font-extrabold">{name}</h3>
		<p class="font-bold">{title}</p>
		<p class="text-sm text-muted">{dates}</p>
		<p>{text}</p>
		<ul class="bullets">
			{bullets.map((bullet: string) => <li>{bullet}</li>)}
		</ul>
		<a href={link} target="_blank" rel="noopener" class="mt-auto pt-3 font-bold underline w-fit">Visit {name}<span class="sr-only"> (opens in a new tab)</span></a>
	</div>
</article>
